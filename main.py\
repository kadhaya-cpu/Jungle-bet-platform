# --- CONFIGURATION ---
SECRET_KEY = "change_this_to_a_secure_random_string_in_production"
ALGORITHM = "HS256"

# --- DEFINE OAUTH2 SCHEME (This enables the Authorize button) ---
oauth2_scheme = OAuth2PasswordBearer(tokenUrl="login")

# --- MOCK DATABASE & MODELS ---
class MockUser:
   def __init__(self, id: int, username: str, hashed_password: str, balance: float = 100.0):
     self.id = id
     self.username = username
     self.hashed_password = hashed_password
     self.balance = balance

class MockDB:
   def __init__(self):
     self.users = {}
     self.next_id = 1

   async def init_db(self):
     print("Database initialized.")

   async def get_user_by_username(self, username: str) -> Optional[MockUser]:
     return next((u for u in self.users.values() if u.username == username), None)

   async def add_user(self, username: str, hashed_password: str) -> MockUser:
     user = MockUser(id=self.next_id, username=username, hashed_password=hashed_password, balance=100.0)
     self.users[user.id] = user 
     self.next_id += 1
     return user

   async def add_coins(self, user_id: int, amount: int, source: str):
     user = next((u for u in self.users.values() if u.id == user_id), None)
     if user:
        user.balance += amount
        return user.balance
     return None

mock_db = MockDB()

# --- AUTH HELPERS ---
def get_password_hash(password: str) -> str:
  return hashlib.sha256(password.encode()).hexdigest()

def verify_password(plain_password: str, hashed_password: str) -> bool:
  return get_password_hash(plain_password) == hashed_password


def create_access_token(data: dict):
  to_encode = data.copy()
  expire = datetime.utcnow() + timedelta(minutes=60) 
  to_encode.update({"exp": expire})
  return jwt.encode(to_encode, SECRET_KEY, algorithm=ALGORITHM)

async def get_user_from_token(token: str) -> Optional[MockUser]:
  try:
     payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])
     username: str = payload.get("sub")
     if username is None: return None
     return await mock_db.get_user_by_username(username)
       except Exception:
         return None

X# --- UPDATED DEPENDENCY USING oauth2_scheme ---
async def get_current_user(token: str = Depends(oauth2_scheme)):
  user = await get_user_from_token(token)
  if not user:
     raise HTTPException(status_code=401, detail="Invalid token")
  return user

