TRAFFIC_SCENARIOS = {
 "Heavy Traffic": {"video": "heavy_traffic.mp4", "probability": 0.4},
 "Smooth Flow": {"video": "smooth_flow.mp4", "probability": 0.4}, 
 "Accident": {"video": "accident_scene.mp4", "probability": 0.1},
 "Rainy Day": {"video": "rainy_day.mp4", "probability": 0.1}
}

@app.get("/traffic/stream/{scenario}", tags=["Game"])
async def get_traffic_video(scenario: str):
  lookup_key = scenario.replace("_", " ")

  if lookup_key not in TRAFFIC_SCENARIOS:
     raise HTTPException(status_code=404, detail="Scenario not found")

  video_filename = TRAFFIC_SCENARIOS[lookup_key]["video"]
  file_path = f"static/videos/{video_filename}"

  if not os.path.exists(file_path):
     raise HTTPException(status_code=500, detail=f"Video file missing: {video_filename}")

  return FileResponse(file_path, media_type="video/mp4")

# --- GAMEPLAY / BETTING LOGIC ---
class BetRequest(BaseModel):
   amount: int
   prediction: str

@app.post("/bet/place", tags=["Game"])
async def place_bet(bet_data: BetRequest, current_user: MockUser = Depends(get_current_user)):
  if bet_data.amount <= 0:
     raise HTTPException(status_code=400, detail="Bet must be positive")


  if current_user.balance < bet_data.amount: 
     raise HTTPException(status_code=400, detail="Insufficient V-Coins!")

  current_user.balance -= bet_data.amount

  scenarios = list(TRAFFIC_SCENARIOS.keys())
  weights = [TRAFFIC_SCENARIOS[s]["probability"] for s in scenarios]
  actual_result = random.choices(scenarios, weights=weights, k=1)[0]

  won = (bet_data.prediction == actual_result)
  winnings = 0

  if won:
     winnings = bet_data.amount * 2

     current_user.balance += winnings
     msg = f"Win! Result: {actual_result}. +{winnings} V-Coins."
  else:
     msg = f"Loss. Result: {actual_result}. -{bet_data.amount} V-Coins."

  url_safe_result = actual_result.replace(" ", "_")
  video_url = f"http://localhost:8000/traffic/stream/{url_safe_result}"


  return {

    "result": "WIN" if won else "LOSS",
    "actual_outcome": actual_result,
    "winnings": winnings,
    "new_balance": current_user.balance,
    "message": msg,
    "video_evidence_url": video_url
  }

