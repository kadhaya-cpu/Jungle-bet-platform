# --- AUTH ENDPOINTS ---
@app.post("/register", tags=["Authentication"])
async def register(username: str, password: str):
  if await mock_db.get_user_by_username(username):
     raise HTTPException(status_code=400, detail="Username exists")

  user = await mock_db.add_user(username, get_password_hash(password))
  return {"message": f"Registered! You got 100 free V-Coins!", "balance": user.balance}

@app.post("/login", tags=["Authentication"])

async def login(form_data: OAuth2PasswordRequestForm = Depends()):
  user = await mock_db.get_user_by_username(form_data.username)
  if not user or not verify_password(form_data.password, user.hashed_password):
     raise HTTPException(status_code=400, detail="Invalid credentials")

  token = create_access_token(data={"sub": user.username})

  return {"access_token": token, "token_type": "bearer", "balance": user.balance}

@app.get("/me/balance", tags=["Game"])
async def get_balance(current_user: MockUser = Depends(get_current_user)):
  return {"username": current_user.username, "v_coins": int(current_user.balance)}

