# ==============================================================================
# RUSH HOUR BET - GLOBAL PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- PLATFORM & BRANDING ---
RUSH_HOUR_BET_ENV="production"
RUSH_HOUR_BET_PLATFORM_NAME="RUSH HOUR BET"
RUSH_HOUR_BET_INTERNAL_CURRENCY="USD"

# --- SMART FEED AGENT & LIVE CAMERA APIs ---
YOUTUBE_API_KEY="your_youtube_data_api_v3_key_here"
EARTHCAM_API_KEY="your_earthcam_api_key_here"
TRAFFIC_CAM_API_KEY="your_traffic_camera_api_key_here"
FALLBACK_VIDEO_PATH="/static/fallback_videos"
MAX_RETRY_ATTEMPTS="3"
HEALTH_CHECK_INTERVAL="30"
FEED_HEALTH_CHECK_INTERVAL="30"
FEED_CACHE_TTL_SECONDS="300"
PERSISTENT_FAILURE_THRESHOLD="3"
RUSH_HOUR_BET_CITIES_CONFIG_PATH="config/cities.json"
RUSH_HOUR_BET_FEED_CONFIG_PATH="config/feed_sources.json"

# --- DATABASE & REDIS ---
DATABASE_URL="postgresql://trafficuser:mypassword@localhost:5432/trafficracer_db"
RUSH_HOUR_BET_DATABASE_URL="postgresql://trafficuser:mypassword@localhost:5432/trafficracer_db"
REDIS_URL="redis://localhost:6379/0"
RUSH_HOUR_BET_REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# --- SECURITY / JWT ---
SECRET_KEY="replace_with_strong_random_cryptographic_secret_key"
RUSH_HOUR_BET_SECRET_KEY="replace_with_strong_random_cryptographic_secret_key"
JWT_SECRET_KEY="replace_with_strong_random_cryptographic_secret_key"
JWT_ALGORITHM="HS256"

# --- MONITORING ALERTS (TELEGRAM & EMAIL) ---
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_admin_chat_id_here"
ADMIN_EMAIL="ops@rushhourbet.io"
SMTP_HOST="smtp.rushhourbet.io"
SMTP_PORT="587"
SMTP_USER="alerts@rushhourbet.io"
SMTP_PASS="your_smtp_password_here"

# --- FRONTEND & CORS ---
VITE_API_BASE_URL="http://localhost:8000"
NEXT_PUBLIC_API_URL="http://localhost:8000"
ALLOWED_ORIGINS="http://localhost:3000,https://rush-hour-bet-frontend.up.railway.app,https://rush-hour-bet.vercel.app"
