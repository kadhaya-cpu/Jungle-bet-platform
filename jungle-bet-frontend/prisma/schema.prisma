datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// USER & AUTHENTICATION SCHEMA
// ==========================================
model User {
  id                String        @id @default(cuid())
  name              String?
  email             String?       @unique
  emailVerified     DateTime?     @map("email_verified")
  image             String?
  phone             String?       @unique
  hashedPassword    String?       @map("hashed_password")
  provider          String        @default("credentials")
  providerAccountId String?       @map("provider_account_id")
  vCoins            Float         @default(100.0) @map("v_coins")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  accounts          Account[]
  sessions          Session[]
  bets              Bet[]
  transactions      Transaction[]

  @@map("users")
}

// NextAuth Account model for OAuth providers (Google, Apple)
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// NextAuth VerificationToken model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==========================================
// JUNGLE BET GAME MODELS
// ==========================================
model Bet {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  betType        String    @map("bet_type")
  criteria       Json
  amount         Float
  status         String    @default("pending")
  resolutionData Json?     @map("resolution_data")
  createdAt      DateTime  @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bets")
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  amount      Float
  type        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}
