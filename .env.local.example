# ========================================================
# RUSH HOUR BET AUTHENTICATION & ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate with your credentials
# ========================================================

# --- SMART FEED AGENT & VIDEO CONFIGURATION ---
YOUTUBE_API_KEY="your_youtube_data_api_v3_key_here"
EARTHCAM_API_KEY="your_earthcam_api_key_here"
FALLBACK_VIDEO_PATH="/static/fallback_videos"

# --- NEXTAUTH V5 CONFIGURATION ---
# Base URL of the Next.js frontend application
NEXTAUTH_URL="http://localhost:3000"

# Random 32+ character string used to encrypt JWT session tokens
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="rush-hour-bet-super-secret-jwt-key-change-in-production-2026"
AUTH_SECRET="rush-hour-bet-super-secret-jwt-key-change-in-production-2026"
RUSH_HOUR_BET_SECRET_KEY="rush-hour-bet-super-secret-jwt-key-change-in-production-2026"

# --- GOOGLE OAUTH 2.0 ---
GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_SECRET="GOCSPX-your-google-client-secret"
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-your-google-client-secret"

# --- APPLE SIGN IN ---
APPLE_ID="com.rushhourbet.web.auth"
APPLE_SECRET="your-apple-generated-client-secret-jwt"
AUTH_APPLE_ID="com.rushhourbet.web.auth"
AUTH_APPLE_SECRET="your-apple-generated-client-secret-jwt"

# --- TWILIO SMS / OTP VERIFICATION ---
TWILIO_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+1234567890"

# --- DATABASE CONFIGURATION ---
DATABASE_URL="postgresql://trafficuser:mypassword@localhost:5432/trafficracer_db"
RUSH_HOUR_BET_DATABASE_URL="postgresql://trafficuser:mypassword@localhost:5432/trafficracer_db"

# --- FASTAPI BACKEND API ---
NEXT_PUBLIC_API_URL="http://localhost:8000"
