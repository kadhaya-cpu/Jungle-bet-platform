# ========================================================
# JUNGLE BET AUTHENTICATION & ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate with your credentials
# ========================================================

# --- NEXTAUTH V5 CONFIGURATION ---
# Base URL of the Next.js frontend application
NEXTAUTH_URL="http://localhost:3000"

# Random 32+ character string used to encrypt JWT session tokens
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="jungle-bet-super-secret-jwt-key-change-in-production-2026"
AUTH_SECRET="jungle-bet-super-secret-jwt-key-change-in-production-2026"

# --- GOOGLE OAUTH 2.0 ---
# Retrieve from Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_SECRET="GOCSPX-your-google-client-secret"
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-your-google-client-secret"

# --- APPLE SIGN IN ---
# Retrieve from Apple Developer Portal: Certificates, Identifiers & Profiles -> Services IDs
# Authorized Return URL: http://localhost:3000/api/auth/callback/apple
APPLE_ID="com.junglebet.web.auth"
APPLE_SECRET="your-apple-generated-client-secret-jwt"
AUTH_APPLE_ID="com.junglebet.web.auth"
AUTH_APPLE_SECRET="your-apple-generated-client-secret-jwt"

# --- TWILIO SMS / OTP VERIFICATION ---
# Retrieve from Twilio Console Dashboard: Account Info
TWILIO_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+1234567890"

# --- DATABASE CONFIGURATION ---
# PostgreSQL connection string (compatible with Prisma and asyncpg SQLAlchemy)
DATABASE_URL="postgresql://trafficuser:mypassword@localhost:5432/trafficracer_db"

# --- FASTAPI BACKEND API ---
# Backend service endpoint
NEXT_PUBLIC_API_URL="http://localhost:8000"
